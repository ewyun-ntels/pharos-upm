          </mxGeometry>
        </mxCell>
        <mxCell id="state-completed-success" value="task_status: &quot;completed&quot;&#10;result_code: &quot;1&quot;&#10;result_message: &quot;success&quot; 또는 STB 응답&#10;control_executed_at: 실행 시각&#10;&#10;✅ 제어 성공&#10;📊 STB 정상 응답&#10;&#10;[DB UPDATE]&#10;&#10;⚠️ 최종 상태 (종료)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
