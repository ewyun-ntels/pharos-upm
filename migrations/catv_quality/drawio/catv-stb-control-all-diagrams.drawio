        <mxCell id="trans-end3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="state-completed-system-error" target="end3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="trans-end4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="state-failed-k8s" target="end4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="summary-box" value="📊 상태 요약&#10;&#10;✅ Pending (대기)&#10;   • K8s Job 생성 성공&#10;   • Worker 실행 대기&#10;   • result_code = &quot;&quot;&#10;&#10;🔄 Running (실행 중)&#10;   • Worker가 TCP 통신 중&#10;   • result_code = &quot;&quot;&#10;&#10;✅ Completed (완료)&#10;   • result_code = &quot;1&quot; (성공)&#10;   • result_code = &quot;0&quot; (장비 에러)&#10;   • result_code = &quot;-1&quot; (시스템 에러)&#10;&#10;❌ Failed (K8s 실패)&#10;   • K8s Job 생성 실패&#10;   • Worker 실행 불가&#10;   • result_code = &quot;&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="360" height="360" as="geometry" />
        </mxCell>
        <mxCell id="retry-box" value="🔄 재시도 로직 (실제 코드 기반)&#10;&#10;1️⃣ 포트 고갈 재시도 (isPortExhaustionError)&#10;   🚨 에러 패턴:&#10;      - &quot;cannot assign requested address&quot; (EADDRNOTAVAIL)&#10;      - &quot;address already in use&quot; (EADDRINUSE)&#10;      - &quot;too many open files&quot; (EMFILE/ENFILE)&#10;   🔁 재시도: Retry.PortExhaustion.Count회&#10;   ⏱️ Delay: Retry.PortExhaustion.Delay (기본 20초)&#10;   📈 Progressive backoff: (attempt+1) × delay&#10;      - 1차: 20초, 2차: 40초, ...&#10;   🕒 TIME_WAIT 대기 (60초 만료 후 포트 재사용)&#10;&#10;2️⃣ 네트워크 재시도 (isRetryableError)&#10;   🚨 재시도 가능 에러:&#10;      - connection refused&#10;      - timeout&#10;      - network unreachable&#10;      - connection reset&#10;      - broken pipe&#10;      - no route to host&#10;   🔁 재시도: Retry.Total.Count회 (기본 3회)&#10;   ⏱️ Delay: Retry.Total.Delay (기본 5초)&#10;   📈 Backoff: attempt × delay&#10;&#10;3️⃣ 최종 실패 (모든 재시도 소진)&#10;   → task_status = &quot;completed&quot;&#10;   → result_code = &quot;-1&quot; (ResponseCodeError)&#10;   → result_message = 마지막 에러 메시지&#10;   → control_executed_at = 실행 시각" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="440" y="540" width="480" height="520" as="geometry" />
        </mxCell>
        <mxCell id="merge-box" value="🔀 ReplacingMergeTree 병합&#10;&#10;ORDER BY (timestamp, job_id, task_id, task_data)&#10;&#10;예시: 동일 task_data (MAC 주소)에 대해&#10;&#10;1️⃣ 최초 삽입 (pending)&#10;   timestamp: 2024-06-01 10:00:00&#10;   task_status: &quot;pending&quot;&#10;   result_code: &quot;&quot;&#10;&#10;2️⃣ Worker 시작 (running)&#10;   timestamp: 2024-06-01 10:00:05&#10;   task_status: &quot;running&quot;&#10;   result_code: &quot;&quot;&#10;&#10;3️⃣ TCP 완료 (completed)&#10;   timestamp: 2024-06-01 10:00:10&#10;   task_status: &quot;completed&quot;&#10;   result_code: &quot;1&quot;&#10;&#10;📋 FINAL 절 조회 시&#10;   → 가장 최근 timestamp 행만 반환&#10;   → task_status: &quot;completed&quot;, result_code: &quot;1&quot;&#10;&#10;⚠️ 중복 제거: v3.0에서 단일 삽입으로 최적화" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="840" y="900" width="480" height="460" as="geometry" />
        </mxCell>
        <mxCell id="platform-box" value="🚧 주의사항 (문서상 제약 - 코드 미구현)&#10;&#10;⚠️ 실제 코드에는 플랫폼별 분기 처리 없음&#10;⚠️ STB가 직접 &quot;not supported&quot; 응답 반환&#10;&#10;[문서상 Android 지원 불가 명령]&#10;   • limitAge (청소년보호)&#10;   • ratingAge (시청등급설정)&#10;   • unlimitAge (청소년보호해제)&#10;   • vipMode (VIP모드설정)&#10;&#10;[문서상 OCAP 모델별 제한]&#10;   • getSerialNumber: SMT-C5210, SMTC7200 미지원&#10;   • getGponOnuId: SMT-C5210 미지원&#10;   • getLanInfo: SMT-H3200 미지원&#10;   • getLanMac: SMT-H3200 미지원&#10;&#10;📝 현재 동작 방식:&#10;→ 모든 work_type 요청 STB로 전송&#10;→ STB가 ResponseCodeFailure (&quot;0&quot;) + &quot;not supported&quot; 반환&#10;→ task_status = &quot;completed&quot;, result_code = &quot;0&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="480" height="420" as="geometry" />
        </mxCell>
        <mxCell id="stats-box" value="📈 실제 통계 예시 (50,000대 제어)&#10;&#10;✅ Completed 성공 (code = &quot;1&quot;)&#10;   49,750대 (99.5%)&#10;&#10;⚠️ Completed 장비 에러 (code = &quot;0&quot;)&#10;   150대 (0.3%)&#10;   - not supported: 80대&#10;   - wrong parameter: 40대&#10;   - no data: 30대&#10;&#10;❌ Completed 시스템 에러 (code = &quot;-1&quot;)&#10;   80대 (0.16%)&#10;   - connection timeout: 50대&#10;   - network unreachable: 30대&#10;&#10;⏳ Pending / Running&#10;   20대 (0.04%)&#10;   - 아직 실행 중&#10;&#10;❌ Failed (K8s 실패)&#10;   0대&#10;   - K8s 인증 정상 가정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="440" y="940" width="360" height="420" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="[05] 시스템 아키텍처" id="05-system-architecture-diagram_architecture-diagram">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SKB CATV STB 제어 시스템 아키텍처 (v3.0)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="layer1-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1900" height="180" as="geometry" />
        </mxCell>
        <mxCell id="layer1-label" value="Layer 1: 외부 인터페이스" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="comp-admin" value="&lt;b&gt;관리자&lt;/b&gt;&#10;&#10;웹 브라우저&#10;또는 API 클라이언트" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="130" width="50" height="100" as="geometry" />
        </mxCell>
        <mxCell id="comp-stb-group" value="&lt;b&gt;STB 장비군&lt;/b&gt;&#10;&#10;📺 SMT-C5210 (OCAP)&#10;📺 SMT-C7200 (OCAP)&#10;📺 SMT-H3200 (Android)&#10;&#10;TCP 포트: 8801&#10;&#10;총 대수: ~80,000대" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1720" y="120" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="layer2-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1900" height="280" as="geometry" />
        </mxCell>
        <mxCell id="layer2-label" value="Layer 2: HTTP API 계층 (Gin Framework)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="comp-http-api" value="&lt;b&gt;HTTP API 서버&lt;/b&gt;&#10;&#10;pkg/control/http/&#10;handler.go, api.go&#10;&#10;주요 엔드포인트:&#10;• POST /catv/stb/control&#10;• GET /catv/stb/control/results (기본 100, 최대 1000)&#10;• GET /catv/stb/control/results/:job_id (기본 1000, 최대 10000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=5;fontSize=11;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="280" y="330" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="comp-memory" value="&lt;b&gt;메모리 캐시 (v3.0)&lt;/b&gt;&#10;&#10;stbControlJobTables&#10;map[string][]StbControlJobTable&#10;&#10;역할:&#10;• Job 데이터 임시 저장&#10;• executionSubTaskMakeData()&#10;• executionSubTaskInsert()&#10;• 중복 DB 삽입 방지&#10;&#10;⚠️ 함수 종료 시 자동 GC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=5;fontSize=11;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="comp-validation" value="&lt;b&gt;검증 로직&lt;/b&gt;&#10;&#10;• work_type 유효성&#10;• work_value 검증&#10;• 플랫폼 호환성 체크&#10;  (Android vs OCAP)&#10;• 모델별 지원 여부&#10;&#10;40개 work_type 지원&#10;(types.go AllWorkTypes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=5;fontSize=11;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="980" y="330" width="260" height="200" as="geometry" />
        </mxCell>
        <mxCell id="layer3-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1900" height="320" as="geometry" />
        </mxCell>
        <mxCell id="layer3-label" value="Layer 3: 오케스트레이션 계층 (Kubernetes)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="comp-k8s-controller" value="&lt;b&gt;Kubernetes API&lt;/b&gt;&#10;&#10;Job Controller&#10;&#10;역할:&#10;• pharos controller-job 생성&#10;• Pod 스케줄링&#10;• 실행 상태 관리&#10;&#10;네임스페이스:&#10;config.Catv.Control.K8sJob.Namespace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=5;fontSize=11;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="100" y="640" width="320" height="230" as="geometry" />
        </mxCell>
        <mxCell id="comp-job0" value="&lt;b&gt;Job Task 0&lt;/b&gt;&#10;&#10;Pod: pharos-controller-job-0&#10;&#10;실행 명령:&#10;/opt/pharos/bin/pharos&#10;  controller-job&#10;  --config=/path/to/config&#10;  --task-id=jobID-0&#10;&#10;※ TYPE, IDS, WORK_TYPE, WORK_VALUE는&#10;  task_data JSON으로 DB 저장&#10;&#10;담당 디바이스: 0~24,999" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=5;fontSize=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="480" y="640" width="260" height="230" as="geometry" />
        </mxCell>
        <mxCell id="comp-job1" value="&lt;b&gt;Job Task 1&lt;/b&gt;&#10;&#10;Pod: pharos-controller-job-1&#10;&#10;실행 명령: (동일)&#10;--task-id=jobID-1&#10;&#10;담당 디바이스: 25,000~49,999" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=5;fontSize=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="800" y="640" width="260" height="230" as="geometry" />
        </mxCell>
        <mxCell id="comp-job2" value="&lt;b&gt;Job Task 2&lt;/b&gt;&#10;&#10;Pod: pharos-controller-job-2&#10;&#10;실행 명령: (동일)&#10;--task-id=jobID-2&#10;&#10;담당 디바이스: 50,000~74,999" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=5;fontSize=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="1120" y="640" width="260" height="230" as="geometry" />
        </mxCell>
        <mxCell id="comp-job3" value="&lt;b&gt;Job Task 3&lt;/b&gt;&#10;&#10;Pod: pharos-controller-job-3&#10;&#10;실행 명령: (동일)&#10;--task-id=jobID-3&#10;&#10;담당 디바이스: 75,000~99,999" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=5;fontSize=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="1440" y="640" width="260" height="230" as="geometry" />
        </mxCell>
        <mxCell id="comp-distribution" value="⚙️ 분산 처리&#10;&#10;총 디바이스: 80,000대&#10;태스크 수: 4개&#10;태스크당 디바이스: ~25,000개&#10;&#10;동시 실행&#10;→ 처리 속도 향상" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=5;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1760" y="640" width="160" height="230" as="geometry" />
        </mxCell>
        <mxCell id="layer4-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1900" height="360" as="geometry" />
        </mxCell>
        <mxCell id="layer4-label" value="Layer 4: Worker 실행 계층 (TCP 제어)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="930" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="comp-worker-pool" value="&lt;b&gt;Worker Pool Handler&lt;/b&gt;&#10;&#10;pkg/control/command/&#10;worker_pool_handler.go&#10;&#10;주요 기능:&#10;• SelectUnprocessedSTBs()&#10;  (task_status=pending 조회)&#10;• Rate Limit (300/초 기본값)&#10;• Goroutine Pool (설정 가능)&#10;• 2단계 재시도 로직&#10;• 포트 고갈 대응&#10;• AsyncBatchWriter 결과 업데이트" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=5;fontSize=11;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="100" y="980" width="340" height="270" as="geometry" />
        </mxCell>
        <mxCell id="comp-tcp-pool" value="&lt;b&gt;TCP Connection Manager&lt;/b&gt;&#10;&#10;직접 연결 방식 (v3.0)&#10;❌ Connection Pool 미사용&#10;✅ 매 요청마다 새 연결&#10;&#10;이유:&#10;• STB 장비 특성상 연결 유지 불안정&#10;• Pool overhead 제거&#10;• 메모리 효율화&#10;&#10;연결 설정:&#10;• Timeout: 3초&#10;• Send Timeout: 5초&#10;• Keep-Alive: 비활성화" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=5;fontSize=11;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="500" y="980" width="340" height="270" as="geometry" />
        </mxCell>
        <mxCell id="comp-parser" value="&lt;b&gt;응답 파싱&lt;/b&gt;&#10;&#10;parseResponse()&#10;&#10;응답 형식:&#10;{&#10;  &quot;code&quot;: &quot;1&quot;,  // 또는 &quot;0&quot;, &quot;-1&quot;&#10;  &quot;message&quot;: &quot;success&quot;&#10;}&#10;&#10;에러 매핑:&#10;• code = &quot;1&quot; → 성공&#10;• code = &quot;0&quot; → 장비 에러&#10;  (wrong parameter, not supported, ...)&#10;• code = &quot;-1&quot; → 시스템 에러&#10;  (timeout, refused, unreachable, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=5;fontSize=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="900" y="980" width="340" height="270" as="geometry" />
        </mxCell>
        <mxCell id="comp-rate-limiter" value="&lt;b&gt;Rate Limiter&lt;/b&gt;&#10;&#10;golang.org/x/time/rate&#10;&#10;설정:&#10;rate.NewLimiter(300, 300)&#10;&#10;제한:&#10;• 초당 300 연결&#10;• 버스트 300&#10;&#10;목적:&#10;• 포트 고갈 방지&#10;• STB 부하 분산&#10;• 네트워크 안정성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=5;fontSize=11;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="1300" y="980" width="280" height="270" as="geometry" />
        </mxCell>
        <mxCell id="comp-retry" value="&lt;b&gt;재시도 전략 (2단계)&lt;/b&gt;&#10;&#10;1️⃣ 포트 고갈 재시도:&#10;   • Retry.PortExhaustion.Count&#10;   • isPortExhaustionError() 체크&#10;     (EADDRNOTAVAIL, EADDRINUSE, EMFILE)&#10;   • Progressive backoff&#10;     (attempt+1) × Delay (기본 20초)&#10;&#10;2️⃣ 전체 재시도:&#10;   • Retry.Total.Count&#10;   • isRetryableError() 체크:&#10;     connection refused, timeout,&#10;     network unreachable, reset,&#10;     broken pipe, no route to host&#10;   • Linear backoff&#10;     attempt × Delay (기본 5초)&#10;&#10;3️⃣ 재시도 불가:&#10;   • 파싱 에러&#10;   • ResponseCodeFailure (&quot;0&quot;)&#10;   • ResponseCodeSuccess (&quot;1&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=5;fontSize=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="1640" y="980" width="280" height="270" as="geometry" />
        </mxCell>
        <mxCell id="layer5-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="1300" width="1900" height="260" as="geometry" />
        </mxCell>
        <mxCell id="layer5-label" value="Layer 5: 데이터 계층 (ClickHouse)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="1310" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="comp-clickhouse" value="&lt;b&gt;ClickHouse 분산 클러스터&lt;/b&gt;&#10;&#10;로컬 테이블: stb_control_job&#10;엔진: ReplicatedReplacingMergeTree(task_updated_at)&#10;ORDER BY: (request_received_at, job_id, task_id, task_data)&#10;PARTITION BY: toYYYYMM(request_received_at)&#10;TTL: request_received_at + 365일&#10;&#10;분산 테이블: dist_stb_control_job&#10;Distributed(cluster, database, stb_control_job, rand())&#10;&#10;※ FINAL 절로 최신 상태만 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=5;fontSize=11;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="100" y="1360" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="comp-schema" value="&lt;b&gt;테이블 스키마 (StbControlJobTable)&lt;/b&gt;&#10;&#10;• request_received_at (DateTime)&#10;• job_id (UUID, 공통 식별자)&#10;• task_id (UUID, 태스크별 식별자)&#10;• task_data (JSON: cm_mac, cm_ip, stb_mac,&#10;  src_ip, work_type, work_value)&#10;• task_status (pending/running/completed/failed)&#10;• task_error_message (String, 에러 상세)&#10;• task_created_at (DateTime)&#10;• task_updated_at (DateTime)&#10;• control_executed_at (Nullable DateTime)&#10;• cm_mac_addr (Cable Modem MAC)&#10;• stb_mac_addr (Set-Top Box MAC)&#10;• work_type (제어 명령 타입)&#10;• result_code (&quot;1&quot;/&quot;0&quot;/&quot;-1&quot;/&quot;&quot;)&#10;• result_message (응답 메시지)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=5;fontSize=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="600" y="1360" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="comp-merge" value="&lt;b&gt;병합 전략 (v3.0 최적화)&lt;/b&gt;&#10;&#10;❌ 이전 (v2.0):&#10;1. pending 삽입 (80K)&#10;2. running 업데이트 → 새 행 삽입 (80K)&#10;3. completed 업데이트 → 새 행 삽입 (80K)&#10;총 240K 행 생성&#10;&#10;✅ 현재 (v3.0):&#10;1. 메모리에서 상태 관리&#10;2. K8s Job 생성 후 pending 삽입 (80K)&#10;3. Worker가 completed 업데이트 (80K → 병합)&#10;총 80K 행만 최종 유지 (67% 감소)&#10;&#10;FINAL 절로 최신 상태만 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=5;fontSize=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="1000" y="1360" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="comp-query" value="&lt;b&gt;쿼리 최적화&lt;/b&gt;&#10;&#10;1️⃣ 조회 시 FINAL 필수:&#10;SELECT * FROM dist_stb_control_job FINAL&#10;WHERE job_id = ?&#10;&#10;2️⃣ 배치 삽입:&#10;INSERT INTO dist_stb_control_job&#10;VALUES (...10,000개...)&#10;&#10;3️⃣ 인덱스 활용:&#10;ORDER BY (request_received_at, job_id, task_id, task_data)&#10;→ job_id, task_id로 빠른 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=5;fontSize=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="1460" y="1360" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="arrow1" value="HTTP POST/GET" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=top;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#6c8ebf;" edge="1" parent="1">
