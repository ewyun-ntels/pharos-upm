        <mxCell id="arrow6" value="조회/업데이트" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=top;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#b85450;startArrow=block;startFill=1;" edge="1" parent="1">
