        <mxCell id="legend-title" value="📖 결과 코드 (result_code) 안내" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="1190" width="300" height="25" as="geometry" />
