        </mxCell>
        <mxCell id="trans4" value="4️⃣ TCP 응답 성공&#10;ResponseCodeSuccess (&quot;1&quot;)&#10;+ BatchWriteRequest (async)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="state-running" target="state-completed-success">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="state-completed-device-error" value="task_status: &quot;completed&quot;&#10;result_code: &quot;0&quot;&#10;result_message:&#10;  - &quot;wrong parameter&quot;&#10;  - &quot;wrong work type&quot;&#10;  - &quot;not supported&quot;&#10;  - &quot;no data, no action&quot;&#10;control_executed_at: 실행 시각&#10;&#10;⚠️ 장비 측 에러&#10;🔧 명령 또는 파라미터 문제&#10;&#10;[DB UPDATE]&#10;&#10;⚠️ 최종 상태 (종료)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1040" y="280" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="trans5" value="5️⃣ TCP 응답 장비 에러&#10;ResponseCodeFailure (&quot;0&quot;)&#10;+ BatchWriteRequest (async)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=top;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="state-running" target="state-completed-device-error">
          <mxGeometry x="0.2" y="20" relative="1" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="780" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-completed-system-error" value="task_status: &quot;completed&quot;&#10;result_code: &quot;-1&quot;&#10;result_message:&#10;  - &quot;connection timeout&quot;&#10;  - &quot;connection refused&quot;&#10;  - &quot;network unreachable&quot;&#10;  - &quot;bind: address already in use&quot; (포트 고갈)&#10;control_executed_at: 실행 시각&#10;&#10;❌ 시스템/네트워크 에러&#10;🔌 연결 불가&#10;&#10;[DB UPDATE]&#10;&#10;⚠️ 최종 상태 (종료)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1040" y="580" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="trans6" value="6️⃣ TCP 연결/통신 실패&#10;ResponseCodeError (&quot;-1&quot;)&#10;+ BatchWriteRequest (async)&#10;&#10;⚠️ 재시도 소진 후" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=top;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="state-running" target="state-completed-system-error">
          <mxGeometry x="0.3" y="20" relative="1" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="780" y="710" />
