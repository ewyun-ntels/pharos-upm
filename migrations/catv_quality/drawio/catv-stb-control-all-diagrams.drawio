        <mxCell id="cat-title" value="명령 카테고리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
