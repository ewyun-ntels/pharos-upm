          <mxGeometry x="80" y="120" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="state-pending" value="task_status: &quot;pending&quot;&#10;result_code: &quot;&quot; (빈 문자열)&#10;result_message: &quot;&quot;&#10;&#10;✅ K8s Job 생성 성공&#10;⏳ Worker 실행 대기&#10;&#10;[메모리 → DB 최초 삽입]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="trans1" value="1️⃣ HTTP POST&#10;+ K8s Job 생성 성공" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="state-pending">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="state-failed-k8s" value="task_status: &quot;failed&quot;&#10;result_code: &quot;&quot; (빈 문자열)&#10;task_error_message: &quot;K8s Job creation failed&quot;&#10;&#10;❌ K8s Job 생성 실패&#10;🚫 Worker 실행 불가&#10;&#10;[메모리에서 상태 변경 → DB 삽입]&#10;&#10;⚠️ 최종 상태 (종료)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="280" width="280" height="180" as="geometry" />
