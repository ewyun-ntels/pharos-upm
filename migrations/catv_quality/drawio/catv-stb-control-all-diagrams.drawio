        </mxCell>
        <mxCell id="end4-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=0;" vertex="1" parent="1">
          <mxGeometry x="587" y="362" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="trans-end1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="state-completed-success" target="end1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="trans-end2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="state-completed-device-error" target="end2">
          <mxGeometry relative="1" as="geometry" />
