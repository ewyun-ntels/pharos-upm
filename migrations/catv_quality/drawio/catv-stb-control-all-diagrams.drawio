        <mxCell id="trans2" value="2️⃣ HTTP POST&#10;+ K8s Job 생성 실패&#10;(Unauthorized, etc.)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=top;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="start" target="state-failed-k8s">
          <mxGeometry x="-0.3" y="20" relative="1" as="geometry">
