        <mxCell id="state-running" value="task_status: &quot;running&quot;&#10;result_code: &quot;&quot; (빈 문자열)&#10;result_message: &quot;&quot;&#10;&#10;🔄 Worker가 실행 중&#10;📡 STB에 TCP 연결 시도&#10;&#10;[DB UPDATE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="trans3" value="3️⃣ Worker Pod 시작&#10;SelectUnprocessedSTBs()&#10;+ BatchWriteRequest (async running)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="state-pending" target="state-running">
          <mxGeometry x="0.1" relative="1" as="geometry">
