        <mxCell id="arrow4" value="TCP 제어" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=top;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#b85450;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
