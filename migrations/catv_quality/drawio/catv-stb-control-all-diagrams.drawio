        <mxCell id="limits-content" value="MaxJobListLimit = 1000      // 최대 조회 개수&#10;DefaultJobListLimit = 100   // 기본 조회 개수&#10;MaxOffsetValue = math.MaxUint64  // 최대 오프셋 (18,446,744,073,709,551,615)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontFamily=Courier New;spacingLeft=15;spacingTop=5;" vertex="1" parent="1">
