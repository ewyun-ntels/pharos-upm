<mxfile host="app.diagrams.net" modified="2026-02-09T00:00:00.000Z" agent="5.0" version="24.0.0">
  <diagram name="상태 전이 다이어그램" id="state-diagram">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 제목 -->
        <mxCell id="title" value="STB 제어 작업 상태 전이 다이어그램" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        
        <!-- 시작점 -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="30" height="30" as="geometry" />
        </mxCell>
        
        <!-- State 1: Pending -->
        <mxCell id="state-pending" value="task_status: &quot;pending&quot;&#xa;result_code: &quot;&quot; (빈 문자열)&#xa;result_message: &quot;&quot;&#xa;&#xa;✅ K8s Job 생성 성공&#xa;⏳ Worker 실행 대기&#xa;&#xa;[메모리 → DB 최초 삽입]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="280" height="140" as="geometry" />
        </mxCell>
        
        <!-- 전이 1: 시작 → Pending -->
        <mxCell id="trans1" value="1️⃣ HTTP POST&#xa;+ K8s Job 생성 성공" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="state-pending">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- State 2: Failed (K8s 실패) -->
        <mxCell id="state-failed-k8s" value="task_status: &quot;failed&quot;&#xa;result_code: &quot;&quot; (빈 문자열)&#xa;task_error_message: &quot;K8s Job creation failed&quot;&#xa;&#xa;❌ K8s Job 생성 실패&#xa;🚫 Worker 실행 불가&#xa;&#xa;[메모리에서 상태 변경 → DB 삽입]&#xa;&#xa;⚠️ 최종 상태 (종료)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="240" y="280" width="280" height="180" as="geometry" />
        </mxCell>
        
        <!-- 전이 2: 시작 → Failed (K8s) -->
        <mxCell id="trans2" value="2️⃣ HTTP POST&#xa;+ K8s Job 생성 실패&#xa;(Unauthorized, etc.)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=top;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="start" target="state-failed-k8s">
          <mxGeometry x="-0.3" y="20" relative="1" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="95" y="370" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- State 3: Running -->
        <mxCell id="state-running" value="task_status: &quot;running&quot;&#xa;result_code: &quot;&quot; (빈 문자열)&#xa;result_message: &quot;&quot;&#xa;&#xa;🔄 Worker가 실행 중&#xa;📡 STB에 TCP 연결 시도&#xa;&#xa;[DB UPDATE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="280" height="140" as="geometry" />
        </mxCell>
        
        <!-- 전이 3: Pending → Running -->
        <mxCell id="trans3" value="3️⃣ Worker Pod 시작&#xa;SelectUnprocessedSTBs()&#xa;+ BatchWriteRequest (async running)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="state-pending" target="state-running">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- State 4: Completed (성공) -->
        <mxCell id="state-completed-success" value="task_status: &quot;completed&quot;&#xa;result_code: &quot;1&quot;&#xa;result_message: &quot;success&quot; 또는 STB 응답&#xa;control_executed_at: 실행 시각&#xa;&#xa;✅ 제어 성공&#xa;📊 STB 정상 응답&#xa;&#xa;[DB UPDATE]&#xa;&#xa;⚠️ 최종 상태 (종료)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1040" y="40" width="280" height="200" as="geometry" />
        </mxCell>
        
        <!-- 전이 4: Running → Completed (성공) -->
        <mxCell id="trans4" value="4️⃣ TCP 응답 성공&#xa;ResponseCodeSuccess (&quot;1&quot;)&#xa;+ BatchWriteRequest (async)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="state-running" target="state-completed-success">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- State 5: Completed (장비 에러) -->
        <mxCell id="state-completed-device-error" value="task_status: &quot;completed&quot;&#xa;result_code: &quot;0&quot;&#xa;result_message:&#xa;  - &quot;wrong parameter&quot;&#xa;  - &quot;wrong work type&quot;&#xa;  - &quot;not supported&quot;&#xa;  - &quot;no data, no action&quot;&#xa;control_executed_at: 실행 시각&#xa;&#xa;⚠️ 장비 측 에러&#xa;🔧 명령 또는 파라미터 문제&#xa;&#xa;[DB UPDATE]&#xa;&#xa;⚠️ 최종 상태 (종료)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1040" y="280" width="280" height="260" as="geometry" />
        </mxCell>
        
        <!-- 전이 5: Running → Completed (장비 에러) -->
        <mxCell id="trans5" value="5️⃣ TCP 응답 장비 에러&#xa;ResponseCodeFailure (&quot;0&quot;)&#xa;+ BatchWriteRequest (async)" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=top;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="state-running" target="state-completed-device-error">
          <mxGeometry x="0.2" y="20" relative="1" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="780" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- State 6: Completed (시스템 에러) -->
        <mxCell id="state-completed-system-error" value="task_status: &quot;completed&quot;&#xa;result_code: &quot;-1&quot;&#xa;result_message:&#xa;  - &quot;connection timeout&quot;&#xa;  - &quot;connection refused&quot;&#xa;  - &quot;network unreachable&quot;&#xa;  - &quot;bind: address already in use&quot; (포트 고갈)&#xa;control_executed_at: 실행 시각&#xa;&#xa;❌ 시스템/네트워크 에러&#xa;🔌 연결 불가&#xa;&#xa;[DB UPDATE]&#xa;&#xa;⚠️ 최종 상태 (종료)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1040" y="580" width="280" height="260" as="geometry" />
        </mxCell>
        
        <!-- 전이 6: Running → Completed (시스템 에러) -->
        <mxCell id="trans6" value="6️⃣ TCP 연결/통신 실패&#xa;ResponseCodeError (&quot;-1&quot;)&#xa;+ BatchWriteRequest (async)&#xa;&#xa;⚠️ 재시도 소진 후" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=top;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="state-running" target="state-completed-system-error">
          <mxGeometry x="0.3" y="20" relative="1" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="780" y="710" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- 종료점들 -->
        <mxCell id="end1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1360" y="125" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end1-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=0;" vertex="1" parent="1">
          <mxGeometry x="1367" y="132" width="16" height="16" as="geometry" />
        </mxCell>
        
        <mxCell id="end2" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1360" y="385" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end2-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=0;" vertex="1" parent="1">
          <mxGeometry x="1367" y="392" width="16" height="16" as="geometry" />
        </mxCell>
        
        <mxCell id="end3" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1360" y="695" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end3-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=0;" vertex="1" parent="1">
          <mxGeometry x="1367" y="702" width="16" height="16" as="geometry" />
        </mxCell>
        
        <mxCell id="end4" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="580" y="355" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end4-inner" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=0;" vertex="1" parent="1">
          <mxGeometry x="587" y="362" width="16" height="16" as="geometry" />
        </mxCell>
        
        <!-- 연결선들 -->
        <mxCell id="trans-end1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="state-completed-success" target="end1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="trans-end2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="state-completed-device-error" target="end2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="trans-end3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="state-completed-system-error" target="end3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="trans-end4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="state-failed-k8s" target="end4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 설명 박스 1: 상태 요약 -->
        <mxCell id="summary-box" value="📊 상태 요약&#xa;&#xa;✅ Pending (대기)&#xa;   • K8s Job 생성 성공&#xa;   • Worker 실행 대기&#xa;   • result_code = &quot;&quot;&#xa;&#xa;🔄 Running (실행 중)&#xa;   • Worker가 TCP 통신 중&#xa;   • result_code = &quot;&quot;&#xa;&#xa;✅ Completed (완료)&#xa;   • result_code = &quot;1&quot; (성공)&#xa;   • result_code = &quot;0&quot; (장비 에러)&#xa;   • result_code = &quot;-1&quot; (시스템 에러)&#xa;&#xa;❌ Failed (K8s 실패)&#xa;   • K8s Job 생성 실패&#xa;   • Worker 실행 불가&#xa;   • result_code = &quot;&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="360" height="360" as="geometry" />
        </mxCell>
        
        <!-- 설명 박스 2: 재시도 로직 -->
        <mxCell id="retry-box" value="🔄 재시도 로직 (실제 코드 기반)&#xa;&#xa;1️⃣ 포트 고갈 재시도 (isPortExhaustionError)&#xa;   🚨 에러 패턴:&#xa;      - &quot;cannot assign requested address&quot; (EADDRNOTAVAIL)&#xa;      - &quot;address already in use&quot; (EADDRINUSE)&#xa;      - &quot;too many open files&quot; (EMFILE/ENFILE)&#xa;   🔁 재시도: Retry.PortExhaustion.Count회&#xa;   ⏱️ Delay: Retry.PortExhaustion.Delay (기본 20초)&#xa;   📈 Progressive backoff: (attempt+1) × delay&#xa;      - 1차: 20초, 2차: 40초, ...&#xa;   🕒 TIME_WAIT 대기 (60초 만료 후 포트 재사용)&#xa;&#xa;2️⃣ 네트워크 재시도 (isRetryableError)&#xa;   🚨 재시도 가능 에러:&#xa;      - connection refused&#xa;      - timeout&#xa;      - network unreachable&#xa;      - connection reset&#xa;      - broken pipe&#xa;      - no route to host&#xa;   🔁 재시도: Retry.Total.Count회 (기본 3회)&#xa;   ⏱️ Delay: Retry.Total.Delay (기본 5초)&#xa;   📈 Backoff: attempt × delay&#xa;&#xa;3️⃣ 최종 실패 (모든 재시도 소진)&#xa;   → task_status = &quot;completed&quot;&#xa;   → result_code = &quot;-1&quot; (ResponseCodeError)&#xa;   → result_message = 마지막 에러 메시지&#xa;   → control_executed_at = 실행 시각" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="440" y="540" width="480" height="520" as="geometry" />
        </mxCell>
        
        <!-- 설명 박스 3: DB 병합 -->
        <mxCell id="merge-box" value="🔀 ReplacingMergeTree 병합&#xa;&#xa;ORDER BY (timestamp, job_id, task_id, task_data)&#xa;&#xa;예시: 동일 task_data (MAC 주소)에 대해&#xa;&#xa;1️⃣ 최초 삽입 (pending)&#xa;   timestamp: 2024-06-01 10:00:00&#xa;   task_status: &quot;pending&quot;&#xa;   result_code: &quot;&quot;&#xa;&#xa;2️⃣ Worker 시작 (running)&#xa;   timestamp: 2024-06-01 10:00:05&#xa;   task_status: &quot;running&quot;&#xa;   result_code: &quot;&quot;&#xa;&#xa;3️⃣ TCP 완료 (completed)&#xa;   timestamp: 2024-06-01 10:00:10&#xa;   task_status: &quot;completed&quot;&#xa;   result_code: &quot;1&quot;&#xa;&#xa;📋 FINAL 절 조회 시&#xa;   → 가장 최근 timestamp 행만 반환&#xa;   → task_status: &quot;completed&quot;, result_code: &quot;1&quot;&#xa;&#xa;⚠️ 중복 제거: v3.0에서 단일 삽입으로 최적화" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="840" y="900" width="480" height="460" as="geometry" />
        </mxCell>
        
        <!-- 설명 박스 4: 플랫폼별 제약 -->
        <mxCell id="platform-box" value="🚧 주의사항 (문서상 제약 - 코드 미구현)&#xa;&#xa;⚠️ 실제 코드에는 플랫폼별 분기 처리 없음&#xa;⚠️ STB가 직접 &quot;not supported&quot; 응답 반환&#xa;&#xa;[문서상 Android 지원 불가 명령]&#xa;   • limitAge (청소년보호)&#xa;   • ratingAge (시청등급설정)&#xa;   • unlimitAge (청소년보호해제)&#xa;   • vipMode (VIP모드설정)&#xa;&#xa;[문서상 OCAP 모델별 제한]&#xa;   • getSerialNumber: SMT-C5210, SMTC7200 미지원&#xa;   • getGponOnuId: SMT-C5210 미지원&#xa;   • getLanInfo: SMT-H3200 미지원&#xa;   • getLanMac: SMT-H3200 미지원&#xa;&#xa;📝 현재 동작 방식:&#xa;→ 모든 work_type 요청 STB로 전송&#xa;→ STB가 ResponseCodeFailure (&quot;0&quot;) + &quot;not supported&quot; 반환&#xa;→ task_status = &quot;completed&quot;, result_code = &quot;0&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="480" height="420" as="geometry" />
        </mxCell>
        
        <!-- 설명 박스 5: 통계 -->
        <mxCell id="stats-box" value="📈 실제 통계 예시 (50,000대 제어)&#xa;&#xa;✅ Completed 성공 (code = &quot;1&quot;)&#xa;   49,750대 (99.5%)&#xa;&#xa;⚠️ Completed 장비 에러 (code = &quot;0&quot;)&#xa;   150대 (0.3%)&#xa;   - not supported: 80대&#xa;   - wrong parameter: 40대&#xa;   - no data: 30대&#xa;&#xa;❌ Completed 시스템 에러 (code = &quot;-1&quot;)&#xa;   80대 (0.16%)&#xa;   - connection timeout: 50대&#xa;   - network unreachable: 30대&#xa;&#xa;⏳ Pending / Running&#xa;   20대 (0.04%)&#xa;   - 아직 실행 중&#xa;&#xa;❌ Failed (K8s 실패)&#xa;   0대&#xa;   - K8s 인증 정상 가정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="440" y="940" width="360" height="420" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
