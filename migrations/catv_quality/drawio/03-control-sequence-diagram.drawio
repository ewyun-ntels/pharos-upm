        <mxCell id="comp-stb" value="STB&#xa;(TCP:8801)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1140" y="100" width="140" height="60" as="geometry" />
        </mxCell>
