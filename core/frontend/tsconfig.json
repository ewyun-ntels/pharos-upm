{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "moduleResolution": "bundler", // keycloak-js는 bundler로 설정해야함
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["jest", "@testing-library/jest-dom"],
    "paths": {
      "@*": ["./src/*"],
      "@routes/*": ["./src/routes/*"],
      "@pharos/core": ["./src"],
      "@pharos/core/*": ["./src/*"],
      "@pharos/core/panel-registry": ["./src/features/dashboard/panels/registry/index.ts"],
      "@pharos/core/panel-registry/corePlugins": ["./src/features/dashboard/panels/registry/corePlugins.ts"],
      "@pharos/core/datasource-editor-registry": ["./src/features/dashboard/datasources/index.ts"],
      "@pharos/core/extension-registry": ["./src/features/extension/registry/index.ts"],
      "@pharos/core/menu-registry": ["./src/features/menu/registry/index.ts"],
      "@pharos/core/filter-registry": ["./src/features/dashboard/filters/registry/index.ts"],
      "@pharos/core/login-registry": ["./src/features/login/index.ts"],
      "@pharos/shared": ["../../shared/frontend/src"],
      "@pharos/shared/*": ["../../shared/frontend/src/*"],
      "@shared/*": ["../../shared/*"],
      "@shared/frontend/*": ["../../shared/frontend/src/*"],
      "@pharos/shared/components": ["../../shared/frontend/src/components"],
      "@pharos/shared/components/*": ["../../shared/frontend/src/components/*"],
      "@pharos/shared/components/template/*": ["../../shared/frontend/src/components/template/*"],
      "@pharos/shared/features/auth": ["../../shared/frontend/src/features/auth"],
      "@pharos/shared/hooks/use-auth": ["../../shared/frontend/src/features/auth"],
      "@pharos/shared/hooks/*": ["../../shared/frontend/src/hooks/*"],
      "@pharos/shared/types/*": ["../../shared/frontend/src/types/*"],
      "@pharos/shared/lib/*": ["../../shared/frontend/src/lib/*"],
      "@pharos/shared/styles/*": ["../../shared/frontend/src/styles/*"],
      "@pharos/shared/utils/*": ["../../shared/frontend/utils/*"],
      "@pharos/extension-*": ["../../extensions/*/frontend/src"],
      "@pharos/meta/*": ["../../meta/generated/frontend/*"],
      "@external-plugins/*": ["../../plugins/panel/*"],
      "@features/*": ["./src/features/*"]
    },
    "incremental": true
  },
  "include": ["src", "types", "vite.config.ts"],
  "exclude": ["node_modules", "../../extensions"]
}
