{
  "name": "@pharos/plugin-my-awesome-panel",
  "version": "1.0.0",
  "description": "Example external panel plugin for Pharos",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "copy": "mkdir -p ../../core/frontend/public/plugins && cp dist/my-awesome-plugin.umd.js ../../core/frontend/public/plugins/",
    "build:prod": "pnpm build && pnpm copy"
  },
  "keywords": [
    "pharos",
    "plugin",
    "panel",
    "visualization"
  ],
  "author": "Your Name",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "recharts": "^2.15.0"
  },
  "pharos": {
    "pluginType": "panel",
    "minVersion": "2.0.0",
    "maxVersion": "3.0.0"
  }
}
