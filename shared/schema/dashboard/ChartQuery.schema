{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChartQuery",
  "description": "Query configuration for chart data source",
  "type": "object",
  "properties": {
    "datasourceName": {
      "type": "string",
      "description": "Name of the datasource"
    },
    "label": {
      "type": "string",
      "description": "Label for the query"
    },
    "query": {
      "type": "string",
      "description": "Query string"
    },
    "forceRefresh": {
      "type": "number",
      "description": "Timestamp to force cache invalidation"
    }
  },
  "required": ["datasourceName", "label", "query"],
  "additionalProperties": false
}
