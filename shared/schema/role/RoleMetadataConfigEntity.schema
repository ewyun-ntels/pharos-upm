{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoleMetadataConfigEntity",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "config": {
      "type": "array",
      "items": {
        "$ref": "RoleMetadata.schema"
      }
    },
    "created_at": {
      "type": "string"
    },
    "updated_by": {
      "type": "string",
      "nullable": true
    },
    "description": {
      "type": "string",
      "nullable": true
    }
  },
  "required": ["id", "config", "created_at"]
}
