{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PasswordPolicy",
  "description": "Password policy configuration from GET /auth/config",
  "type": "object",
  "properties": {
    "min_length": {
      "type": "integer",
      "description": "Minimum password length"
    },
    "min_uppercase": {
      "type": "integer",
      "description": "Minimum uppercase characters required"
    },
    "min_lowercase": {
      "type": "integer",
      "description": "Minimum lowercase characters required"
    },
    "min_digits": {
      "type": "integer",
      "description": "Minimum digit characters required"
    },
    "min_special": {
      "type": "integer",
      "description": "Minimum special characters required"
    },
    "password_ttl": {
      "type": "integer",
      "description": "Password time-to-live in seconds"
    }
  },
  "required": ["min_length", "min_uppercase", "min_lowercase", "min_digits", "min_special"],
  "additionalProperties": false
}
