{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthConfig",
  "description": "Authentication configuration from GET /auth/config",
  "type": "object",
  "properties": {
    "common": {
      "type": "object",
      "description": "Common authentication settings",
      "properties": {
        "login_retry_reset_timeout": {
          "type": "integer",
          "description": "Time in seconds to reset login retry count"
        },
        "login_block_duration": {
          "type": "integer",
          "description": "Duration in seconds for temporary account block"
        },
        "collect_client_info": {
          "type": "boolean",
          "description": "Whether to collect and expose client IP and User-Agent",
          "default": false
        }
      },
      "required": ["login_retry_reset_timeout", "login_block_duration"],
      "additionalProperties": false
    },
    "password": {
      "$ref": "PasswordPolicy.schema"
    },
    "user": {
      "$ref": "UserPolicy.schema"
    }
  },
  "required": ["common", "password", "user"],
  "additionalProperties": false
}
