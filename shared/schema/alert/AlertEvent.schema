{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AlertEvent",
    "description": "Schema for external alert events sent to event-based alert rules",
    "type": "object",
    "properties": {
        "alert_id": {
            "type": "string",
            "description": "Unique identifier for the alert event",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "description": "Human-readable description of the event"
        },
        "severity": {
          "$ref": "AlertSeverity.schema"
        },
        "value": {
            "type": "number",
            "description": "Numeric value associated with the event"
        },
        "labels": {
            "type": "object",
            "description": "Key-value labels for categorizing and identifying the event",
            "additionalProperties": {
                "type": "string"
            },
            "default": {}
        }
    },
    "required": ["alert_id", "severity"],
    "additionalProperties": false
}
