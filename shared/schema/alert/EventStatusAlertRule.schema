{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventStatusAlertRule",
  "description": "Schema for event-status alert rules that handle external events and maintain alert status",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the alert rule",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "description": "Name of the alert rule",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Description shown when alert is triggered"
    },
    "notifications": {
      "type": "array",
      "description": "List of notification destinations",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "alert_type": {
      "const": "event-status"
    }
  },
  "additionalProperties": false
}
