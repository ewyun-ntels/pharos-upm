{
  "title": "Alert History Request",
  "description": "Request schema for querying alert history with filtering parameters",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Filter by alert rule name",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$",
      "examples": ["cpu_high", "memory_usage"]
    },
    "startTime": {
      "type": "string",
      "format": "date-time",
      "description": "Start time for history query (ISO 8601 format)",
      "examples": ["2024-01-01T00:00:00Z"]
    },
    "endTime": {
      "type": "string",
      "format": "date-time",
      "description": "End time for history query (ISO 8601 format)",
      "examples": ["2024-12-31T23:59:59Z"]
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 1000,
      "description": "Maximum number of history records to return"
    }
  },
  "additionalProperties": false
}