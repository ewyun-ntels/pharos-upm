{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QueryNotificationRule",
  "description": "Schema for SNMP notification rules that send SNMP traps when alerts are triggered",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the notification rule",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "description": "Name of the notification rule",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Description of the notification rule"
    },
    "value_oid": {
      "type": "string",
      "description": "OID for the alert value"
    },
    "description_oid": {
      "type": "string",
      "description": "OID for the alert description"
    },
    "status_oid": {
      "type": "string",
      "description": "OID for the alert status"
    },
    "exclude_filter": {
      "type": "object",
      "description": "Filter to exclude specific label values",
      "additionalProperties": true
    },
    "trap_pdu_rule": {
      "type": "array",
      "description": "Rules for mapping alert labels to SNMP PDUs",
      "items": {
        "type": "object",
        "properties": {
          "label_name": {
            "type": "string",
            "description": "Name of the alert label to map",
            "minLength": 1
          },
          "oid": {
            "type": "string",
            "description": "SNMP OID for this label",
            "minLength": 1
          },
          "value_type": {
            "type": "string",
            "description": "SNMP value type",
            "enum": [
              "OctetString",
              "counter32",
              "gauge32",
              "counter64",
              "uinteger32",
              "opaqueFloat",
              "opaqueDouble",
              "objectIdentifier"
            ]
          }
        },
        "required": [
          "label_name",
          "oid"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "port": {
      "type": "integer",
      "description": "SNMP port number",
      "minimum": 1,
      "maximum": 65535,
      "default": 162
    },
    "target": {
      "type": "string",
      "description": "Target IP address or hostname",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "description": "SNMP version",
      "enum": [2, 3],
      "default": 2
    },
    "transport": {
      "type": "string",
      "description": "Transport protocol",
      "enum": ["udp", "tcp"],
      "default": "udp"
    },
    "snmpv2_config": {
      "type": "object",
      "description": "SNMPv2 configuration",
      "properties": {
        "community": {
          "type": "string",
          "description": "SNMP community string",
          "minLength": 1
        }
      },
      "required": ["community"],
      "additionalProperties": false
    },
    "snmpv3_config": {
      "type": "object",
      "description": "SNMPv3 configuration",
      "properties": {
        "authoritative_engine_id": {
          "type": "string",
          "description": "Authoritative engine ID in hex format"
        },
        "username": {
          "type": "string",
          "description": "SNMPv3 username",
          "minLength": 1
        },
        "auth_protocol": {
          "type": "string",
          "description": "Authentication protocol",
          "enum": ["sha", "sha224", "sha256", "sha384", "sha512", "md5"]
        },
        "auth_passphrase": {
          "type": "string",
          "description": "Authentication passphrase"
        },
        "priv_protocol": {
          "type": "string",
          "description": "Privacy protocol",
          "enum": ["des", "aes", "aes192", "aes256"]
        },
        "priv_passphrase": {
          "type": "string",
          "description": "Privacy passphrase"
        }
      },
      "required": ["username"],
      "additionalProperties": false
    },
    "append_pdu": {
      "type": "array",
      "description": "Additional PDUs to append to SNMP traps",
      "items": {
        "type": "object",
        "properties": {
          "oid": {
            "type": "string",
            "description": "SNMP OID",
            "minLength": 1
          },
          "value_type": {
            "type": "string",
            "description": "SNMP value type",
            "enum": [
              "OctetString",
              "counter32",
              "gauge32",
              "counter64",
              "uinteger32",
              "opaqueFloat",
              "opaqueDouble",
              "objectIdentifier"
            ],
            "minLength": 1
          },
          "value": {
            "description": "Value to send"
          }
        },
        "required": [
          "oid",
          "value_type",
          "value"
        ],
        "additionalProperties": false
      },
      "default": []
    }
  },
  "required": [
    "name",
    "target"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "version": { "const": 2 }
      },
      "required": ["snmpv2_config"]
    },
    {
      "properties": {
        "version": { "const": 3 }
      },
      "required": ["snmpv3_config"]
    }
  ]
}