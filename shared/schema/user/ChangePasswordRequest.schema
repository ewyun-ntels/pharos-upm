{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ntels.com/pharos/schemas/user/ChangePasswordRequest.schema.json",
  "title": "ChangePasswordRequest",
  "description": "Request body for changing user password (PUT /user/{username}/password)",
  "type": "object",
  "properties": {
    "password": {
      "type": "string",
      "description": "New password for the user",
      "minLength": 1
    }
  },
  "required": ["password"],
  "additionalProperties": false
}
