{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ntels.com/pharos/schemas/user/BlockUserRequest.schema.json",
  "title": "BlockUserRequest",
  "description": "Request body for blocking/unblocking user (PUT /user/{username}/block)",
  "type": "object",
  "properties": {
    "block": {
      "type": "boolean",
      "description": "Whether to block (true) or unblock (false) the user"
    }
  },
  "required": ["block"],
  "additionalProperties": false
}
