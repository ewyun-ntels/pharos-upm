{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ntels.com/pharos/schemas/user/UpdatePasswordExpirationRequest.schema.json",
  "title": "UpdatePasswordExpirationRequest",
  "description": "Request body for updating password expiration date (PUT /user/{username}/password-expire-date)",
  "type": "object",
  "properties": {
    "expired_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Password expiration timestamp (null to remove expiration)"
    }
  },
  "required": ["expired_at"],
  "additionalProperties": false
}
