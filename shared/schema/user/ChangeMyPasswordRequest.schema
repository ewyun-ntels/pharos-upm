{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ntels.com/pharos/schemas/user/ChangeMyPasswordRequest.schema.json",
  "title": "ChangeMyPasswordRequest",
  "description": "Request body for changing current user's password (PUT /me/password)",
  "type": "object",
  "properties": {
    "current_password": {
      "type": "string",
      "description": "Current password for verification",
      "minLength": 1
    },
    "new_password": {
      "type": "string",
      "description": "New password",
      "minLength": 1
    }
  },
  "required": ["current_password", "new_password"],
  "additionalProperties": false
}
