{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "VersionResponse",
  "description": "Schema for version information API response",
  "properties": {
    "module": {
      "type": "string",
      "description": "Module name"
    },
    "version": {
      "type": "string", 
      "description": "Version string"
    },
    "commit": {
      "type": "string",
      "description": "Git commit hash"
    },
    "build_time": {
      "type": "string",
      "format": "date-time",
      "description": "Build timestamp"
    },
    "updated_at": {
      "type": "string", 
      "format": "date-time",
      "description": "Last update timestamp"
    }
  },
  "required": ["module", "version", "commit", "build_time", "updated_at"],
  "additionalProperties": false
}